{
    "name": "@koni/api",
    "private": true,
    "version": "1.0.0",
    "type": "module",
    "engines": {
        "node": ">=20 <23"
    },
    "scripts": {
        "dev:api": "npm run dev",
        "dev": "tsx watch src/index.ts",
        "build": "tsc",
        "start": "node dist/index.js",
        "lint": "tsc --noEmit",
        "db:seed": "node --experimental-strip-types prisma/seed.ts",
        "db:reset": "npx prisma migrate reset --force",
        "db:studio": "npx prisma studio",
        "test:api": "node --experimental-strip-types scripts/verify-phase2.ts",
        "test:phase3": "node --experimental-strip-types scripts/verify-phase3.ts",
        "test:phase4": "node --experimental-strip-types scripts/verify-phase4.ts",
        "test:public": "node --experimental-strip-types scripts/verify-public-surface.ts"
    },
    "dependencies": {
        "@prisma/client": "6.2.1",
        "bcryptjs": "^3.0.3",
        "brackets-manager": "^1.9.0",
        "brackets-memory-db": "^1.0.5",
        "cors": "^2.8.5",
        "dotenv": "^16.4.0",
        "exceljs": "^4.4.0",
        "express": "^4.21.0",
        "express-rate-limit": "^8.3.0",
        "helmet": "^8.1.0",
        "jsonwebtoken": "^9.0.3",
        "multer": "^2.1.1",
        "node-cron": "^4.2.1",
        "nodemailer": "^8.0.1",
        "pdfkit": "^0.17.2",
        "pdfkit-table": "^0.1.99",
        "prisma": "6.2.1",
        "socket.io": "^4.8.3",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@types/bcryptjs": "^2.4.6",
        "@types/cors": "^2.8.17",
        "@types/express": "^5.0.0",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/multer": "^2.1.0",
        "@types/node": "^22.10.0",
        "@types/node-cron": "^3.0.11",
        "@types/nodemailer": "^7.0.11",
        "@types/pdfkit": "^0.17.5",
        "tsx": "^4.19.0",
        "typescript": "^5.7.0"
    }
}
