# === Fase 0-1: Google Workspace Integration ===
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-secret
GOOGLE_SHEETS_ID=your-google-sheets-id
GOOGLE_DRIVE_FOLDER_ID=your-drive-folder-id
ADMIN_PASSWORD=your-admin-password

# === Fase 2+: PostgreSQL & Redis ===
# Runtime app (serverless): gunakan pooled URL (Supavisor transaction mode, port 6543)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
# Prisma CLI migrate/generate: gunakan direct/session URL (non-pooled)
DIRECT_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
REDIS_URL=redis://localhost:6379

# === Authentication ===
JWT_SECRET=your-jwt-secret-256bit
JWT_REFRESH_SECRET=your-refresh-secret-256bit

# === Storage (Fase 2+) ===
AWS_S3_BUCKET=koni-kabmalang-assets
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key

# === Email ===
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@koni-kabmalang.or.id
SMTP_PASS=your-app-password

# === Frontend ===
VITE_API_URL=http://localhost:3000/api/v1
FRONTEND_URL=http://localhost:5173

# === Monitoring ===
SENTRY_DSN=https://xxx@oyyy.ingest.sentry.io/zzz

# === Server ===
PORT=3000
NODE_ENV=development
